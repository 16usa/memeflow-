# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Repository metadata and development dependencies are not runtime assets.
.git
.cache
node_modules
memeflow-app/node_modules
**/node_modules

# Local backups and generated build/toolchain output.
.memeflow-backups
.memeflow-*-backup-*
.memeflow-*-backups
memeflow-app/.memeflow-*-backup-*
memeflow-app/.visual-clean-backups
memeflow-app/smart-vault/**/target
memeflow-app/smart-vault/**/.toolchain

# MEMEFLOW runtime state is generated locally and is unsuitable for an
# autoscale image's ephemeral filesystem.
memeflow-app/data/chart-history-v30-10
memeflow-app/data/state.json
memeflow-app/data/state.json.bak
memeflow-app/data/state.json.tmp.*
memeflow-app/data/state.json.bak.tmp.*
memeflow-app/data/token-registry-v1.sqlite
memeflow-app/data/token-registry-v1.sqlite-shm
memeflow-app/data/token-registry-v1.sqlite-wal
memeflow-app/data/platform-trade-analytics-v2.sqlite
memeflow-app/data/platform-trade-analytics-v2.sqlite-shm
memeflow-app/data/platform-trade-analytics-v2.sqlite-wal
memeflow-app/data/learning-dataset-v23-3.jsonl
memeflow-app/data/outcome-calibration-v23-11.jsonl
memeflow-app/data/shadow-error-aware-benchmark-v23-19.jsonl
memeflow-app/data/shadow-error-pattern-learner-v23-17.jsonl
memeflow-app/data/shadow-outcome-review-v23-16.jsonl
memeflow-app/data/token-intelligence-v23.jsonl
memeflow-app/data/token-pattern-memory-v23-9.jsonl
memeflow-app/data/token-trajectory-v23-8.jsonl
memeflow-app/data/v24-policy-bridge-audit.jsonl
memeflow-app/data/wallet-reputation-v23-2.jsonl
