    if(!r.ok)return;

    const m=await r.json().catch(()=>null);

    if(!m||typeof m!=='object')return;

    const image=__mfWsMetadataUrl(
      m.image ||
      m.image_url ||
      m.imageUrl ||
      m.logo ||
