/* MEMEFLOW BRAND FINAL V6 — single canonical layer
   One master geometry everywhere. Dark/light differ only in color processing.
*/
:root{
  --mf-logo-dark:url("/brand/memeflow-dragonfly-dark.png?v=final-v5");
  --mf-logo-light:url("/brand/memeflow-dragonfly-light.png?v=final-v5");
}
.mf-brand-img{display:block;object-fit:contain;filter:drop-shadow(0 3px 8px rgba(0,229,240,.18));}
.logo{
  width:40px!important;height:40px!important;min-width:40px!important;flex:0 0 40px!important;
  display:inline-block!important;border:0!important;border-radius:0!important;box-shadow:none!important;
  background:var(--mf-logo-dark) center/contain no-repeat!important;
}
.logo::before,.logo::after{content:none!important;display:none!important;}
.brand-mark{
  width:58px!important;height:42px!important;min-width:58px!important;flex:0 0 58px!important;
  display:inline-flex!important;align-items:center!important;justify-content:center!important;
  padding:0!important;margin:0!important;border:0!important;border-radius:0!important;
  background:none!important;box-shadow:none!important;color:transparent!important;font-size:0!important;line-height:0!important;
}
.brand-mark>span,.brand-mark>i,.brand-mark::before,.brand-mark::after{display:none!important;content:none!important;}
.brand-mark .mf-brand-img{width:56px!important;height:38px!important;}
html[data-theme="light"] .logo, body.light .logo, .theme-light .logo{background-image:var(--mf-logo-light)!important;}
html[data-theme="light"] .mf-brand-img, body.light .mf-brand-img, .theme-light .mf-brand-img{content:url("/brand/memeflow-dragonfly-light.png?v=final-v5");}
@media (prefers-color-scheme:light){
  html:not([data-theme="dark"]) .logo{background-image:var(--mf-logo-light)!important;}
}
@media(max-width:820px){
  .brand-mark{width:54px!important;height:40px!important;min-width:54px!important;flex-basis:54px!important;}
  .brand-mark .mf-brand-img{width:52px!important;height:36px!important;}
}

/* MEMEFLOW LOADER FINAL V9 — pinned wing roots, clean mobile loader */
.boot-mark{
  width:144px!important;
  height:112px!important;
  min-width:144px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  border:0!important;
  border-radius:0!important;
  background:none!important;
  box-shadow:none!important;
  overflow:visible!important;
}
.boot-mark>i,.boot-mark::before,.boot-mark::after{
  display:none!important;
  content:none!important;
}

.mf-loader-v9{
  position:relative;
  width:140px;
  height:108px;
  display:block;
  overflow:visible;
  transform:translateZ(0);
  filter:drop-shadow(0 8px 20px rgba(0,225,240,.24));
  animation:mfV9Float 1.9s ease-in-out infinite;
}
.mf-loader-v9 img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:contain;
  pointer-events:none;
  will-change:transform,opacity,filter;
}
.mf-loader-v9 .mf-v9-glow{
  z-index:1;
  animation:mfV9Glow 1.2s ease-in-out infinite alternate;
}
.mf-loader-v9 .mf-v9-ul{
  z-index:2;
  transform-origin:46.2% 40.6%;
  animation:mfV9UL .64s cubic-bezier(.42,0,.58,1) infinite alternate;
}
.mf-loader-v9 .mf-v9-ur{
  z-index:2;
  transform-origin:53.8% 40.6%;
  animation:mfV9UR .64s cubic-bezier(.42,0,.58,1) infinite alternate;
}
.mf-loader-v9 .mf-v9-ll{
  z-index:3;
  transform-origin:46.2% 42.8%;
  animation:mfV9LL .78s cubic-bezier(.42,0,.58,1) .08s infinite alternate;
}
.mf-loader-v9 .mf-v9-lr{
  z-index:3;
  transform-origin:53.8% 42.8%;
  animation:mfV9LR .78s cubic-bezier(.42,0,.58,1) .08s infinite alternate;
}
.mf-loader-v9 .mf-v9-body{
  z-index:5;
  animation:mfV9Body 1.45s ease-in-out infinite;
}

/* Roots stay pinned; motion comes mainly from wing foreshortening. */
@keyframes mfV9UL{
  0%{transform:scaleY(.72) rotate(-1.2deg);opacity:.82}
  100%{transform:scaleY(1.03) rotate(.8deg);opacity:1}
}
@keyframes mfV9UR{
  0%{transform:scaleY(.72) rotate(1.2deg);opacity:.82}
  100%{transform:scaleY(1.03) rotate(-.8deg);opacity:1}
}
@keyframes mfV9LL{
  0%{transform:scaleY(.83) rotate(-.7deg);opacity:.78}
  100%{transform:scaleY(1.015) rotate(.5deg);opacity:.96}
}
@keyframes mfV9LR{
  0%{transform:scaleY(.83) rotate(.7deg);opacity:.78}
  100%{transform:scaleY(1.015) rotate(-.5deg);opacity:.96}
}
@keyframes mfV9Glow{
  from{opacity:.22;transform:scale(.97)}
  to{opacity:.60;transform:scale(1.045)}
}
@keyframes mfV9Body{
  0%,100%{filter:brightness(.98)}
  50%{filter:brightness(1.10)}
}
@keyframes mfV9Float{
  0%,100%{transform:translateY(2px)}
  50%{transform:translateY(-3px)}
}

@media (prefers-reduced-motion:reduce){
  .mf-loader-v9{animation:mfV9Float 2.8s ease-in-out infinite!important}
  .mf-loader-v9 .mf-v9-ul,.mf-loader-v9 .mf-v9-ur{animation-duration:1.2s!important}
  .mf-loader-v9 .mf-v9-ll,.mf-loader-v9 .mf-v9-lr{animation-duration:1.4s!important}
}

