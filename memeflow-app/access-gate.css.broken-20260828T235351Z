}

.mf-ag-btn{
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:9px!important;
}

.mf-ag-btn-icon{
  width:17px;
  height:17px;
  display:inline-flex;
  flex:0 0 17px;
  color:#8ee9ff;
}

.mf-ag-foot{
  display:flex!important;
  justify-content:center!important;
  align-items:flex-start!important;
  gap:7px!important;
}

.mf-ag-note-icon{
