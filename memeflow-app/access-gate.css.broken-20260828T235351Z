/* MEMEFLOW SMART VAULT ACCESS V8 */
#mf-ag-wallet-connect{
  width:100%;
  cursor:pointer;
  font-family:inherit;
}

#mf-ag-wallet-connect:active{
  transform:translateY(1px);
}

/* MEMEFLOW LOCK BADGE */
.mf-ag-card{
  position:relative;
}

.mf-ag-lock{
  position:absolute;
  top:18px;
  right:18px;
  width:46px;
  height:46px;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(180deg, rgba(20,40,58,.88), rgba(7,18,30,.92));
  border:1px solid rgba(73,190,255,.28);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.03) inset,
    0 8px 24px rgba(0,0,0,.30),
    0 0 20px rgba(61,184,255,.10);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.mf-ag-lock svg{
  width:22px;
  height:22px;
  stroke:#69d3ff;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
  opacity:.95;
}

@media (max-width: 640px){
  .mf-ag-lock{
    top:14px;
    right:14px;
    width:40px;
    height:40px;
    border-radius:12px;
  }

  .mf-ag-lock svg{
    width:19px;
    height:19px;
  }
}

/* === MEMEFLOW ACCESS ICONS PATCH === */
.mf-ag-with-icon{
  display:flex;
  align-items:center;
  gap:10px;
}

.mf-ag-inline-icon,
.mf-ag-btn-icon,
.mf-ag-note-icon{
  flex:0 0 auto;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  color:#63d8ff;
}

.mf-ag-inline-icon{
  width:18px;
  height:18px;
  opacity:.96;
  filter:drop-shadow(0 0 10px rgba(99,216,255,.18));
}

.mf-ag-inline-icon svg,
.mf-ag-btn-icon svg,
.mf-ag-note-icon svg{
  width:100%;
  height:100%;
}

.mf-ag-btn-with-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
}

.mf-ag-btn-icon{
  width:18px;
  height:18px;
  opacity:.98;
  filter:drop-shadow(0 0 10px rgba(99,216,255,.2));
}

.mf-ag-note-with-icon{
  display:flex;
  align-items:flex-start;
  justify-content:center;
  gap:10px;
}

.mf-ag-note-icon{
  width:16px;
  height:16px;
  margin-top:2px;
  opacity:.9;
}

@media (max-width: 640px){
  .mf-ag-inline-icon{ width:17px; height:17px; }
  .mf-ag-btn-icon{ width:17px; height:17px; }
  .mf-ag-note-icon{ width:15px; height:15px; }
}

/* MEMEFLOW ACCESS ICONS FIX V11 */
.mf-ag-tier b{
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
}

.mf-ag-mini-icon{
