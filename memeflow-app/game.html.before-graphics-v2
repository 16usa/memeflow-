<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="description" content="MEMEFLOW Rocket — paper game driven by live MEMEFLOW market data.">
  <title>MEMEFLOW Rocket · Paper Game</title>
  <link rel="stylesheet" href="/game.css">
</head>
<body>
  <div class="game-shell" id="gameShell" data-stage="ground" data-state="idle">
    <header class="game-topbar">
      <a class="brand" href="/" aria-label="Back to MEMEFLOW">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i></span>
        <span><b>MEMEFLOW</b><small>ROCKET</small></span>
      </a>
      <div class="paper-badge"><i></i> PAPER GAME</div>
      <div class="top-balance"><small>Virtual balance</small><b id="gameBalance">$10,000.00</b></div>
    </header>

    <main class="game-layout">
      <aside class="control-panel glass">
        <div class="panel-kicker">LAUNCH CONTROL</div>
        <h1>Ride the market.</h1>
        <p class="panel-copy">MEMEFLOW selects a current BUY READY candidate. The rocket follows that token's live market price.</p>

        <label class="field-label" for="betInput">Paper stake</label>
        <div class="money-input">
          <span>$</span>
          <input id="betInput" inputmode="decimal" min="1" step="1" type="number" value="100" aria-label="Paper stake">
        </div>
        <div class="quick-row" aria-label="Quick stake amounts">
          <button type="button" data-bet="25">$25</button>
          <button type="button" data-bet="50">$50</button>
          <button type="button" data-bet="100" class="active">$100</button>
          <button type="button" data-bet="250">$250</button>
        </div>

        <div class="control-grid">
          <label>
            <span>Auto cash out</span>
            <select id="autoCashout">
              <option value="0">Manual</option>
              <option value="1.2">1.20×</option>
              <option value="1.5" selected>1.50×</option>
              <option value="2">2.00×</option>
              <option value="2.5">2.50×</option>
              <option value="5">5.00×</option>
            </select>
          </label>
          <label>
            <span>Stop loss</span>
            <select id="stopLoss">
              <option value="0">Off</option>
              <option value="0.9">0.90×</option>
              <option value="0.8">0.80×</option>
              <option value="0.75" selected>0.75×</option>
              <option value="0.6">0.60×</option>
            </select>
          </label>
        </div>

        <button class="launch-btn" id="startBtn" type="button">
          <span class="launch-icon">▶</span>
          <span><b>START</b><small>Find a filtered launch</small></span>
        </button>
        <button class="cashout-btn" id="cashoutBtn" type="button" disabled>
          <span class="stop-icon">■</span>
          <span><b>CASH OUT</b><small id="cashoutButtonValue">Waiting for launch</small></span>
        </button>

        <div class="paper-note">
          <b>No real trade is executed.</b>
          <span>This first version uses a virtual balance and live MEMEFLOW market data.</span>
        </div>
      </aside>

      <section class="flight-card glass" aria-live="polite">
        <div class="flight-head">
          <div>
            <div class="status-pill" id="roundStatus"><i></i><span>READY</span></div>
            <div class="status-message" id="statusMessage">Set a paper stake and start the round.</div>
          </div>
          <div class="round-id"><small>ROUND</small><b id="roundId">—</b></div>
        </div>

        <div class="multiplier-wrap">
          <div class="multiplier" id="multiplier">1.00<span>×</span></div>
          <div class="multiplier-caption">LIVE POSITION MULTIPLIER</div>
        </div>

        <div class="sky" id="sky" aria-hidden="true">
          <div class="stars stars-a"></div>
          <div class="stars stars-b"></div>
          <div class="moon"></div>
          <div class="cloud cloud-a"></div>
          <div class="cloud cloud-b"></div>
          <div class="trajectory"><i></i></div>
          <div class="altitude altitude-5"><span>5.00×</span></div>
          <div class="altitude altitude-2"><span>2.00×</span></div>
          <div class="altitude altitude-15"><span>1.50×</span></div>
          <div class="altitude altitude-12"><span>1.20×</span></div>
          <div class="altitude altitude-1"><span>1.00×</span></div>

          <div class="rocket-wrap" id="rocketWrap">
            <div class="rocket-glow"></div>
            <div class="frog-mascot">
              <span class="frog-eye left"></span><span class="frog-eye right"></span>
              <span class="frog-mouth"></span>
            </div>
            <div class="rocket-body">
              <div class="rocket-window"></div>
              <div class="rocket-fin fin-left"></div><div class="rocket-fin fin-right"></div>
              <div class="rocket-flame"><i></i><i></i><i></i></div>
            </div>
          </div>

          <div class="launch-pad"><i></i><span></span></div>
          <div class="earth"></div>
        </div>

        <div class="position-bar">
          <div><small>Stake</small><b id="stakeValue">$100.00</b></div>
          <div><small>Paper value</small><b id="positionValue">$100.00</b></div>
          <div><small>P&amp;L</small><b id="profitValue">$0.00</b></div>
          <div><small>Peak</small><b id="peakValue">1.00×</b></div>
        </div>
      </section>

      <aside class="intel-panel">
        <section class="glass intel-card target-card">
          <div class="intel-head"><span>TARGET</span><b id="targetBadge">WAITING</b></div>
          <div class="token-line">
            <div class="token-orb" id="tokenOrb">?</div>
            <div><b id="tokenName">Waiting for launch</b><small id="tokenMint">MEMEFLOW will choose a BUY READY candidate.</small></div>
          </div>
          <div class="screening-grid">
            <div><small>AI score</small><b id="tokenScore">—</b></div>
            <div><small>Holders</small><b id="tokenHolders">—</b></div>
            <div><small>Top 10</small><b id="tokenTop10">—</b></div>
            <div><small>Buy pressure</small><b id="tokenPressure">—</b></div>
          </div>
          <div class="risk-line"><span>Selection status</span><b id="selectionStatus">Filtered candidate required</b></div>
        </section>

        <section class="glass intel-card history-card">
          <div class="intel-head"><span>ROUND HISTORY</span><button id="clearHistory" type="button">Clear</button></div>
          <div class="history-list" id="historyList">
            <div class="empty-history">No completed rounds yet.</div>
          </div>
        </section>
      </aside>
    </main>

    <footer class="game-footer">
      <span><i class="live-dot"></i><b id="feedState">Market feed idle</b></span>
      <span id="sourceState">Source: MEMEFLOW candidate + chart stream</span>
      <a href="/">Back to trading terminal</a>
    </footer>
  </div>

  <div class="result-overlay" id="resultOverlay" hidden>
    <div class="result-card glass">
      <div class="result-eyebrow" id="resultEyebrow">ROUND COMPLETE</div>
      <div class="result-multiplier" id="resultMultiplier">1.00×</div>
      <h2 id="resultTitle">Cashed out</h2>
      <div class="result-grid">
        <div><small>Stake</small><b id="resultStake">$0.00</b></div>
        <div><small>Paper payout</small><b id="resultPayout">$0.00</b></div>
        <div><small>P&amp;L</small><b id="resultProfit">$0.00</b></div>
      </div>
      <button id="playAgainBtn" type="button">PLAY AGAIN</button>
    </div>
  </div>

  <script src="/game.js" defer></script>
</body>
</html>
