<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta http-equiv="Cache-Control" content="no-store,no-cache,must-revalidate,max-age=0">
<title>PEPE Calibrator V7</title>

<style>
:root{
  --bg:#020607;
  --panel:#07100f;
  --line:#245246;
  --accent:#7fffc8;
  --text:#ffffff;
  --muted:#9aada7;
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,sans-serif;
}

body{
  padding:
    max(5px,env(safe-area-inset-top))
    7px
    max(7px,env(safe-area-inset-bottom));
}

.header{
  height:30px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 4px;
}

.title{
  font-size:13px;
  font-weight:900;
}

#status{
  color:var(--accent);
  font-size:10px;
  font-weight:900;
}

#stage{
  position:relative;
  width:100%;
  height:34svh;
  min-height:210px;
  max-height:340px;
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:14px;
  background:
    radial-gradient(circle at 50% 42%, #15312b, #06110f 55%, #020504);
}

#stage canvas{
  position:absolute;
  inset:0;
  width:100%!important;
  height:100%!important;
  display:block;
}

.tabs2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
  margin-top:6px;
}

.hand{
  height:36px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--panel);
  color:var(--muted);
  font-weight:900;
}

.hand.active{
  background:var(--accent);
  color:#00100b;
}

#controls{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4px;
  margin-top:5px;
}

.control{
  padding:5px 6px;
  border:1px solid #173b31;
  border-radius:9px;
  background:var(--panel);
}

.top{
  display:flex;
  justify-content:space-between;
  gap:5px;
  margin-bottom:1px;
}

.name{
  color:var(--accent);
  font-size:9px;
  font-weight:900;
}

.value{
  font:800 9px ui-monospace,monospace;
}

.main{
  display:grid;
  grid-template-columns:27px 1fr 27px;
  gap:4px;
  align-items:center;
}

.nudge{
  width:27px;
  height:26px;
  padding:0;
  border:1px solid #285448;
  border-radius:7px;
  background:#0a1916;
  color:white;
  font-size:16px;
  font-weight:900;
}

input[type=range]{
  width:100%;
  height:25px;
  margin:0;
  accent-color:#55eeb2;
}

.actions{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:4px;
  margin-top:5px;
}

.action{
  height:36px;
  border:1px solid var(--line);
  border-radius:9px;
  background:#081411;
  color:white;
  font-size:10px;
  font-weight:900;
}

.action.copy{
  background:var(--accent);
  color:#00100b;
}

#result{
  display:none;
  max-height:110px;
  overflow:auto;
  margin-top:4px;
  padding:6px;
  border:1px solid var(--line);
  border-radius:8px;
  color:var(--accent);
  background:#010403;
  font:9px/1.3 ui-monospace,monospace;
  white-space:pre-wrap;
}

#result.open{
  display:block;
}

@media(max-height:700px){
  #stage{
    height:31svh;
    min-height:190px;
  }
}
</style>
</head>
<body>

<div class="header">
  <div class="title">PEPE CALIBRATOR V7</div>
  <div id="status">LOADING</div>
</div>

<div id="stage"></div>

<div class="tabs2">
  <button id="left" class="hand active">LEFT HAND</button>
  <button id="right" class="hand">RIGHT HAND</button>
</div>

<div id="controls"></div>

<div class="actions">
  <button id="resetHand" class="action">RESET HAND</button>
  <button id="resetAll" class="action">RESET ALL</button>
  <button id="copy" class="action copy">COPY VALUES</button>
</div>

<div id="result"></div>

<script type="module" src="/character-rig-calibrator.js?v=1786671870"></script>
</body>
</html>
