<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
<title>MEMEFLOW · Game Flight</title>
<style>
:root{--safe-top:max(12px,env(safe-area-inset-top));--safe-bottom:max(12px,env(safe-area-inset-bottom));--panel:#071017e8;--line:#1d3442;--text:#f5f8fb;--muted:#8495a6;--good:#68e5ad;--bad:#ff7183}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#03070c;color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif}body{background:radial-gradient(circle at 70% 26%,#142333 0%,#071018 36%,#02060a 76%)}
#game{position:fixed;inset:0;overflow:hidden;touch-action:none}
#stage{position:absolute;inset:0;overflow:hidden}#stage canvas{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;display:block!important}
#hud{position:absolute;z-index:10;top:calc(var(--safe-top) + 4px);left:14px;right:14px;display:flex;gap:10px;justify-content:space-between;pointer-events:none}
.hud-card{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:15px;backdrop-filter:blur(14px);box-shadow:0 14px 40px #0008}.status{padding:11px 13px;max-width:420px;flex:1}.status strong{display:block;font-size:12px;letter-spacing:.08em}.status span{display:block;color:var(--muted);font-size:11px;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mult{padding:11px 13px;text-align:right;min-width:118px}.mult b{display:block;font:800 16px ui-monospace,SFMono-Regular,Menlo,monospace}.mult small{color:var(--muted);font-size:10px}
#targetLine,#stopLine{position:absolute;z-index:4;left:8%;right:7%;height:1px;pointer-events:none}#targetLine{top:20%;background:linear-gradient(90deg,transparent,#63e5ad66 12%,#63e5ad66 88%,transparent)}#stopLine{top:84%;background:linear-gradient(90deg,transparent,#ff718355 12%,#ff718355 88%,transparent)}.line-label{position:absolute;right:2px;bottom:7px;font:700 9px ui-monospace,monospace;letter-spacing:.07em}#targetLine .line-label{color:#72e6b4}#stopLine .line-label{color:#ff8291}
#controls{
position:absolute;
z-index:12;
left:8px;
right:8px;
width:auto;
max-width:none;
display:grid;
grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.15fr);
gap:6px;
padding:6px;
overflow:hidden;
box-sizing:border-box;
}
.field{min-width:0;max-width:100%;overflow:hidden;height:52px;padding:7px 10px;border:1px solid #203442;border-radius:12px;background:#08121a}.field label{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}.field input{width:100%;border:0;outline:0;background:transparent;color:#fff;font:800 15px ui-monospace,monospace;padding:0}.field small{color:#647687;font-size:8px}.start{min-width:0;max-width:100%;overflow:hidden;white-space:nowrap;border:1px solid #25664e;border-radius:12px;background:linear-gradient(180deg,#123b2d,#0a241c);color:#b9ffdc;font-weight:900;letter-spacing:.04em;font-size:13px}.start:active{transform:translateY(1px)}
#demo{
position:absolute;
z-index:11;
left:8px;
right:8px;
width:auto;
max-width:none;
display:grid;
grid-template-columns:repeat(5,minmax(0,1fr));
gap:5px;
overflow:hidden;
box-sizing:border-box;
}.demoBtn{min-width:0;height:28px;padding:0 4px;border-radius:8px;border:1px solid #1d3442;background:#071017cc;color:#9baaba;font-size:8px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.demoBtn:active{background:#10202c}
#result{position:absolute;z-index:20;inset:0;display:none;place-items:center;background:#02060a88;backdrop-filter:blur(4px)}#result.show{display:grid}.result-card{width:min(360px,82vw);padding:24px;text-align:center;border:1px solid #233a49;border-radius:22px;background:#071017f2;box-shadow:0 22px 70px #000c}.result-card h2{margin:0 0 8px;font-size:22px}.result-card p{margin:0;color:#8495a6;font-size:12px}.result-card button{margin-top:16px;height:42px;padding:0 18px;border-radius:11px;border:1px solid #2b5366;background:#0b1a24;color:#eaf5fc;font-weight:800}

.demoBtn,
.start,
.field,
.field input {
  min-width:0 !important;
  max-width:100% !important;
  width:100% !important;
  box-sizing:border-box !important;
}

.demoBtn {
  height:34px !important;
  padding:0 4px !important;
  font-size:9px !important;
  line-height:1 !important;
  white-space:nowrap !important;
  overflow:hidden !important;
  text-overflow:ellipsis !important;
}

.start {
  height:52px !important;
  padding:0 8px !important;
  font-size:12px !important;
  white-space:nowrap !important;
  overflow:hidden !important;
}

.field {
  height:52px !important;
  padding:6px 9px !important;
}

@media (max-width:600px) {
  #demo {
    left:4px;
    right:4px;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:4px;
  }

  .demoBtn {
    height:30px !important;
    font-size:8px !important;
  }

  #controls {
    left:4px;
    right:4px;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    gap:5px;
    padding:5px;
  }

  .start {
    grid-column:1 / -1;
    height:48px !important;
    font-size:11px !important;
  }

  .field {
    height:48px !important;
  }
}

@media (orientation:landscape) and (max-height:500px) {
  #demo {
    left:8px;
    right:8px;
    grid-template-columns:repeat(5,minmax(0,1fr));
  }

  .demoBtn {
    height:30px !important;
    font-size:8px !important;
  }

  #controls {
    left:8px;
    right:8px;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,.8fr);
  }

  .start {
    grid-column:auto;
    height:48px !important;
    font-size:10px !important;
  }

  .field {
    height:48px !important;
  }
}

</style>
</head>
<body>
<div id="game">
  <div id="stage"></div>
  <div id="targetLine"><span class="line-label" id="targetLabel">TARGET 5.00x</span></div>
  <div id="stopLine"><span class="line-label" id="stopLabel">NO STOP-LOSS</span></div>
  <div id="hud">
    <div class="hud-card status"><strong id="state">READY</strong><span id="subState">Choose target and press START</span></div>
    <div class="hud-card mult"><b id="multiplier">1.00x</b><small id="pnl">+0.0%</small></div>
  </div>
  <div id="demo">
    <button class="demoBtn" data-demo="flight">FLIGHT</button>
    <button class="demoBtn" data-demo="stop">STOP</button>
    <button class="demoBtn" data-demo="crash">NO-STOP CRASH</button>
    <button class="demoBtn" data-demo="cash">CASH OUT</button>
    <button class="demoBtn" data-demo="win">TARGET</button>
  </div>
  <div id="controls">
    <div class="field"><label>Target</label><input id="target" type="number" value="5" min="1.05" max="100" step="0.05"><small>multiplier</small></div>
    <div class="field"><label>Stop-loss</label><input id="stop" type="number" placeholder="OFF" min="0.1" max="99" step="0.5"><small>% · blank = off</small></div>
    <button id="start" class="start">START ROUND</button>
  </div>
  <div id="result"><div class="result-card"><h2 id="resultTitle">ROUND COMPLETE</h2><p id="resultText"></p><button id="again">PLAY AGAIN</button></div></div>
</div>
<script type="module" src="/game-flight-v1.js?v=2"></script>
</body>
</html>


