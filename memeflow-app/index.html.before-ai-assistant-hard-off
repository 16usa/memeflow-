 function render(dirty=true){const o=read();$('#settingsProfileSummary').textContent=o.strategyProfile||'Not configured';$('#settingsModeSummary').textContent=o.operatingMode||'Not configured';$('#settingsDailySummary').textContent=o.dailySpendLimit!==''?`${n(o,'dailySpendLimit').toFixed(2)} SOL`:'—';$('#settingsSizeSummary').textContent=o.positionSize!==''?`${n(o,'positionSize').toFixed(2)} SOL`:'—';$('#strategyProfileBadge').textContent=o.strategyProfile||'NOT CONFIGURED';const errors=validate(o);$('#settingsErrors').classList.toggle('show',errors.length>0&&Boolean(loaded));$('#settingsErrorsText').textContent=errors.join(' ');$('#settingsSave').disabled=!loaded||errors.length>0;if(dirty&&loaded){$('#settingsSaveState').textContent=errors.length?'Fix invalid limits':'Unsaved server changes';$('#settingsSaveState').style.color=errors.length?'var(--red)':'var(--yellow)'}updateAutomateEligibility()}
