/* ===== consolidated: product-hardening-final-css ===== */
/* Product Hardening — final design-system and hierarchy pass */
:root{
  --space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:24px;
  --radius-sm:9px;--radius-md:13px;--radius-lg:18px;
  --control-h:40px;--panel-bg:rgba(10,15,21,.92);
}
.panel{box-shadow:0 14px 38px rgba(0,0,0,.24);border-color:rgba(41,57,74,.66)}
.panel-head{padding:11px 13px}.panel-body{padding:13px}
.btn{min-height:var(--control-h);border-radius:var(--radius-sm)}
.context-banner{padding:15px 16px;border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(84,221,255,.08),rgba(10,15,21,.96) 44%,rgba(166,140,255,.045));box-shadow:0 16px 42px rgba(0,0,0,.22)}
.context-copy b{font-size:clamp(17px,2.1vw,25px);letter-spacing:-.035em}.context-copy p{max-width:760px}
.context-actions{align-self:center}
/* Remove duplicate primary surfaces; keep one Command Center */
.operation-line,.change-rail,.mobile-primary-brief,.mobile-signal,.signal-deck{display:none!important}
.hero{min-height:0}.hero-title{font-size:clamp(25px,3.4vw,44px);max-width:760px}.hero-sub{max-width:760px}
.mission-facts{grid-template-columns:repeat(5,minmax(0,1fr));margin:14px 0 10px}.mission-actions{display:none}
.mission-grid{grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr)}
/* Compact status ribbon */
.connection-strip{grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;margin:10px 0}.connection-item{padding:8px 9px;border-radius:10px;min-width:0}.connection-item b{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.quality-strip{display:none!important}
/* Operator timeline */
.operator-timeline{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;margin:10px 0 12px}
.operator-step{position:relative;border:1px solid var(--line);border-radius:10px;padding:8px 9px;background:rgba(7,11,16,.72);min-width:0}
.operator-step small{display:block;color:var(--muted);font-size:7px;text-transform:uppercase;letter-spacing:.08em}.operator-step b{display:block;margin-top:4px;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.operator-step.done{border-color:rgba(81,231,168,.25)}.operator-step.done b{color:var(--green)}.operator-step.active{border-color:rgba(84,221,255,.46);box-shadow:inset 3px 0 var(--cyan)}.operator-step.locked{opacity:.64}
/* Execution = one reason first, details second */
.execution-preview{padding:14px;border-radius:var(--radius-lg)}
.execution-head{margin-bottom:8px}.execution-grid{grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}.exec-cell{padding:8px 7px}.exec-cell b{font-size:10px}
.primary-blocker{display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid rgba(246,199,95,.25);background:rgba(246,199,95,.05);border-radius:11px;padding:10px 12px;margin:9px 0}
.primary-blocker div{min-width:0}.primary-blocker small{display:block;color:var(--yellow);font-size:7px;text-transform:uppercase;letter-spacing:.09em}.primary-blocker b{display:block;margin-top:4px;font-size:11px}.primary-blocker span{color:var(--muted);font-size:9px;line-height:1.4}
.execution-readiness{margin-top:8px;padding:9px}.execution-verdict{margin-top:8px}
/* Candidate feed as compact work queue */
.workspace{grid-template-columns:245px minmax(0,1fr) 290px}.candidate{padding:9px 10px;border-radius:10px}.candidate-name{font-size:12px}.candidate-meta{margin-top:4px}.candidate.active{box-shadow:inset 3px 0 var(--cyan)}
.primary-card{gap:9px}.token-name{font-size:24px}.big-score{font-size:46px}.metric-row{gap:6px}.metric{padding:8px}.check-strip{gap:4px}.mini-check{padding:7px 4px}
/* Position-first visual priority */
body[data-product-mode="position"] #positions{scroll-margin-top:14px}
body[data-product-mode="position"] #positions>.panel:first-child{border-color:rgba(81,231,168,.55);box-shadow:0 0 0 1px rgba(81,231,168,.1),0 20px 46px rgba(0,0,0,.28)}
body[data-product-mode="position"] .context-banner{border-color:rgba(81,231,168,.45)}
/* Wallet professional summary */
.wallet-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:6px}.wallet-stat{padding:8px}.wallet-stat b{font-size:10px}.wallet-session-note{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:7px}.wallet-session-note div{border:1px solid var(--line);border-radius:9px;padding:8px;background:rgba(7,11,16,.64)}.wallet-session-note small{display:block;color:var(--muted);font-size:7px;text-transform:uppercase}.wallet-session-note b{display:block;margin-top:4px;font-size:9px}
/* Incident center takeover */
body[data-product-mode="incident"] #system{border-color:rgba(255,101,118,.56);box-shadow:0 0 0 1px rgba(255,101,118,.09),0 24px 54px rgba(0,0,0,.3)}
/* Progressive disclosure */
.decision-intelligence,.advanced-intelligence{box-shadow:none;background:rgba(8,13,19,.72)}
/* Responsive */
@media(max-width:1100px){.mission-facts{grid-template-columns:repeat(3,1fr)}.mission-facts .fact:nth-child(n+4){grid-column:auto}.operator-timeline{grid-template-columns:repeat(3,1fr)}.execution-grid{grid-template-columns:repeat(4,1fr)}.wallet-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:820px){
 .context-banner{padding:12px;gap:10px}.context-actions{width:100%;display:grid;grid-template-columns:1fr 1fr}.context-actions .btn{width:100%}
 .connection-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.connection-item:last-child{grid-column:1/-1}
 .operator-timeline{grid-template-columns:repeat(2,1fr)}
 .mission-grid{display:block}.mission-grid>.panel:last-child{margin-top:9px}.mission-facts{grid-template-columns:repeat(2,1fr)}
 .execution-grid{grid-template-columns:repeat(2,1fr)}.primary-blocker{align-items:flex-start;flex-direction:column}
 .wallet-grid{grid-template-columns:repeat(2,1fr)}.wallet-session-note{grid-template-columns:1fr 1fr}.wallet-session-note div:last-child{grid-column:1/-1}
 .workspace{display:block}
}
@media(max-width:390px){.operator-timeline{grid-template-columns:1fr 1fr}.mission-facts{grid-template-columns:1fr 1fr}.connection-strip{grid-template-columns:1fr 1fr}.execution-grid,.wallet-grid,.wallet-session-note{grid-template-columns:1fr}.wallet-session-note div:last-child{grid-column:auto}.context-actions{grid-template-columns:1fr}}

