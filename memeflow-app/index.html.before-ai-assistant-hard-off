<script id="MEMEFLOW_AI_ASSISTANT_JS_V1">
(()=>{
  'use strict';

  const button=document.getElementById('mfAiButton');
  const panel=document.getElementById('mfAiPanel');
  const close=document.getElementById('mfAiClose');
  const form=document.getElementById('mfAiForm');
  const input=document.getElementById('mfAiInput');
  const send=document.getElementById('mfAiSend');
  const messages=document.getElementById('mfAiMessages');
  const contextLabel=document.getElementById('mfAiContext');

  if(!button||!panel||!form)return;

  const history=[];

  function candidate(){
    try{
      return window.MEMEFLOW_CORE?.getSelected?.() || {};
    }catch{
      return {};
    }
  }

  function compactCandidate(c={}){
    return {
      name:c.name ?? null,
      symbol:c.symbol ?? null,
      mint:c.mint ?? c.tokenAddress ?? null,
      state:c.state ?? null,
      score:c.score ?? null,
      confidence:
        c.confidence ??
        c.aiConfidence ??
        c.evidenceConfidence ??
        null,
      priority:c.priority ?? null,
      holderCount:c.holderCount ?? null,
      top10Pct:c.top10Pct ?? null,
      developerPct:
        c.developerPct ??
        c.developerSharePct ??
        null,
      buyPressure:
        c.buyPressure ??
        c.momentum ??
        null,
      liquidity:
        c.liquidityUsd ??
        c.liquidity ??
        null,
      marketCap:
        c.marketCapUsd ??
        c.marketCap ??
        null,
      reasons:Array.isArray(c.reasons)
        ? c.reasons.slice(0,12)
        : []
    };
  }

  function updateContext(){
    const c=candidate();

    contextLabel.textContent=c?.name
      ? `${c.name}${c.state?' · '+c.state:''}${c.score!=null?' · Score '+c.score:''}`
      : 'No candidate selected';
  }

  function add(text,role='assistant'){
    const el=document.createElement('div');
    el.className='mf-ai-msg '+role;
    el.textContent=String(text||'');
    messages.appendChild(el);
    messages.scrollTop=messages.scrollHeight;
  }

  async function getSettings(){
    try{
      const r=await fetch('/api/settings',{
        credentials:'include',
        cache:'no-store'
      });

      if(!r.ok)return null;

      const d=await r.json();

      return d?.settings || d || null;
    }catch{
      return null;
    }
  }

  button.addEventListener('click',()=>{
    panel.classList.toggle('open');
    updateContext();

    if(panel.classList.contains('open')){
      setTimeout(()=>input.focus(),60);
    }
  });

  close.addEventListener('click',()=>{
    panel.classList.remove('open');
  });

  window.addEventListener(
    'memeflow:candidatechange',
    updateContext
  );

  form.addEventListener('submit',async event=>{
    event.preventDefault();

    const message=input.value.trim();
    if(!message)return;

    const c=compactCandidate(candidate());
    const settings=await getSettings();

    add(message,'user');

    history.push({
      role:'user',
      content:message
    });

    input.value='';
    send.disabled=true;
    send.textContent='…';

    try{
      const r=await fetch('/api/ai/assistant',{
        method:'POST',
        credentials:'include',
        headers:{
          'content-type':'application/json'
        },
        body:JSON.stringify({
          message,
          messages:history.slice(-8),
          context:{
            candidate:c,
            settings
          }
        })
      });

      const d=await r.json().catch(()=>({}));

      if(!r.ok || !d?.ok){
        add(
          d?.message ||
          `AI Assistant unavailable (${r.status})`,
          'error'
        );
        return;
      }

      add(d.text,'assistant');

      history.push({
        role:'assistant',
        content:d.text
      });

      while(history.length>10){
        history.shift();
      }

    }catch(error){
      add(
        'AI Assistant connection failed. MEMEFLOW trading logic is unaffected.',
        'error'
      );
    }finally{
      send.disabled=false;
      send.textContent='Send';
      input.focus();
    }
  });

  updateContext();
})();
</script>


