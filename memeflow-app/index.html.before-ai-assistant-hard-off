<script id="MEMEFLOW_MANUAL_SCAN_V1">
(() => {
  'use strict';

  if(window.__MEMEFLOW_MANUAL_SCAN_V1__) return;
  window.__MEMEFLOW_MANUAL_SCAN_V1__ = true;

  const esc = value =>
    String(value ?? '')
      .replaceAll('&','&amp;')
      .replaceAll('<','&lt;')
      .replaceAll('>','&gt;')
      .replaceAll('"','&quot;')
      .replaceAll("'","&#039;");

  const fmt = (value, suffix='') => {
    if(value === null || value === undefined || value === '') return '—';
    const n = Number(value);
    if(!Number.isFinite(n)) return '—';

    if(Math.abs(n) >= 1000000)
      return (n/1000000).toFixed(2)+'M'+suffix;

    if(Math.abs(n) >= 1000)
      return (n/1000).toFixed(2)+'K'+suffix;

    if(Math.abs(n) >= 100)
      return n.toFixed(0)+suffix;

    return n.toFixed(2)+suffix;
  };

  const extractMint = raw => {
    const value = String(raw || '').trim();

    const match = value.match(
      /[1-9A-HJ-NP-Za-km-z]{32,44}/
    );

    return match ? match[0] : value;
  };

  function mount(){
    if(document.querySelector('#manualAiScan')) return;

    const target =
      document.querySelector('#primary-candidate') ||
      document.querySelector('.primary-card') ||
      document.querySelector('#decision-studio') ||
      document.querySelector('main') ||
      document.querySelector('.main');

    if(!target) return;

    const box = document.createElement('section');
    box.id = 'manualAiScan';
    box.className = 'manual-ai-scan';

    box.innerHTML = `
      <div class="manual-ai-scan-head">
        <div>
          <small>MANUAL AI SCAN</small>
          <h3>Analyze any Solana token</h3>
        </div>
        <span class="state wait">ON DEMAND</span>
      </div>

      <div class="manual-ai-scan-body">
        <form class="manual-ai-scan-form"
              id="manualAiScanForm">
          <input
            class="manual-ai-scan-input"
            id="manualAiMint"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Paste mint, Pump.fun or DexScreener link"
          >
          <button class="btn primary"
                  id="manualAiSubmit"
                  type="submit">
            Analyze token
          </button>
        </form>

        <p class="manual-ai-scan-hint">
          Uses the same MEMEFLOW AI evaluator and your current
          Settings. Manual scans never enter the automatic
          Candidate Feed and never execute a trade.
        </p>

        <div class="manual-ai-error"
             id="manualAiError"></div>

        <div class="manual-ai-result"
             id="manualAiResult"></div>
      </div>
    `;

    if(target.id === 'primary-candidate' ||
       target.classList.contains('primary-card') ||
       target.id === 'decision-studio'){
      target.parentNode.insertBefore(box,target);
    }else{
      target.prepend(box);
    }

    document
      .querySelector('#manualAiScanForm')
      ?.addEventListener('submit', analyze);
  }

  async function analyze(event){
    event.preventDefault();

    const input =
      document.querySelector('#manualAiMint');

    const button =
      document.querySelector('#manualAiSubmit');

    const error =
      document.querySelector('#manualAiError');

    const result =
      document.querySelector('#manualAiResult');

    const mint = extractMint(input?.value);

    error.classList.remove('show');
    error.textContent = '';

    result.classList.remove('show');
    result.innerHTML = '';

    if(!mint){
      error.textContent =
        'Enter a Solana mint address.';
      error.classList.add('show');
      return;
    }

    button.disabled = true;
    button.textContent = 'Scanning…';

    try{
      const r = await fetch('/api/manual/analyze',{
        method:'POST',
        credentials:'include',
        headers:{
          'content-type':'application/json',
          accept:'application/json'
        },
        body:JSON.stringify({mint})
      });

      const d = await r.json().catch(()=>({}));

      if(!r.ok){
        throw new Error(
          d?.message ||
          d?.error ||
          'Manual analysis failed'
        );
      }

      renderResult(d);

      window.MEMEFLOW_MANUAL_SCAN = d;

      window.dispatchEvent(
        new CustomEvent('memeflow:manualscan',{
          detail:d
        })
      );

    }catch(e){
      error.textContent =
        e?.message || 'Manual analysis failed.';
      error.classList.add('show');
    }finally{
      button.disabled = false;
      button.textContent = 'Analyze token';
    }
  }

  function renderResult(d){
    const result =
      document.querySelector('#manualAiResult');

    const t = d?.token || {};
    const decision = d?.decision || {};
    const settings = d?.settingsApplied || {};
    const external = d?.external || {};

    const state =
      String(decision.state || 'WAITING');

    const cls =
      state === 'BUY READY'
        ? 'buy'
        : state === 'BLOCKED'
          ? 'block'
          : 'wait';

    const reasons =
      Array.isArray(decision.reasons) &&
      decision.reasons.length
        ? decision.reasons
        : [
            decision.primaryReason ||
            'No blocking reason returned.'
          ];

    const settingsText = [
      settings.minScore != null
        ? `AI ≥ ${settings.minScore}` : null,

      settings.minConfidence != null
        ? `Confidence ≥ ${settings.minConfidence}%` : null,

      settings.minHolders != null
        ? `Holders ≥ ${settings.minHolders}` : null,

      settings.maxTop10Pct != null
        ? `Top-10 ≤ ${settings.maxTop10Pct}%` : null,

      settings.maxDeveloperPct != null
        ? `Developer ≤ ${settings.maxDeveloperPct}%` : null,

      settings.minBuyPressure != null
        ? `Pressure ≥ ${settings.minBuyPressure}×` : null

    ].filter(Boolean).join(' · ');

    result.innerHTML = `
      <div class="manual-ai-result-top">
        <div class="manual-ai-token">
          <div class="manual-ai-token-title-row">
            <div class="manual-ai-token-logo" id="manualAiTokenLogo">
              ${esc((t.symbol || t.name || '?').charAt(0).toUpperCase())}
            </div>

            <div class="manual-ai-token-title">
              <small>MANUAL ANALYSIS</small>
              <b>${esc(t.name || t.symbol || d.mint)}</b>
            </div>
          </div>

          <span class="manual-ai-state ${cls}">
            ${esc(state)}
          </span>
        </div>

        <div class="manual-ai-score">
          <strong>${esc(decision.score ?? '—')}</strong>
          <small>AI SCORE</small>
        </div>
      </div>

      <div class="manual-ai-metrics">
        <div class="manual-ai-metric">
          <small>Confidence</small>
          <b>${fmt(decision.confidence,'%')}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Holders</small>
          <b>${fmt(t.holderCount)}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Top-10</small>
          <b>${fmt(t.top10Pct,'%')}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Developer</small>
          <b>${fmt(t.developerPct,'%')}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Buy pressure</small>
          <b>${fmt(t.buyPressure,'×')}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Liquidity</small>
          <b>$${fmt(t.liquidityUsd)}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Market cap</small>
          <b>$${fmt(t.marketCapUsd)}</b>
        </div>

        <div class="manual-ai-metric">
          <small>Evidence</small>
          <b>${fmt(d?.evidence?.completeness,'%')}</b>
        </div>
      </div>

      <div class="manual-ai-reasons">
        <b>
          ${
            state === 'BUY READY'
              ? 'AI recommendation: BUY READY'
              : state === 'BLOCKED'
                ? 'AI recommendation: DO NOT BUY'
                : 'AI recommendation: WAIT'
          }
        </b>

        <div>
          ${reasons.map(esc).join('<br>')}
        </div>
      </div>

      <div class="manual-ai-settings">
        Evaluated with current Settings:
        ${esc(settingsText || 'server configuration')}
        · ${esc(d.durationMs)} ms
      </div>

      <div class="manual-ai-links">
        <a href="${esc(external.pump)}"
           target="_blank"
           rel="noopener">
          Pump.fun
        </a>

        <a href="${esc(external.dexscreener)}"
           target="_blank"
           rel="noopener">
          DexScreener
        </a>

        <a href="${esc(external.bubblemap)}"
           target="_blank"
           rel="noopener">
          Bubble map
        </a>
      </div>
    `;

    result.classList.add('show');

    const logo = document.querySelector('#manualAiTokenLogo');

    if(logo){
      const first = (...values) => {
        for(const value of values){
          if(typeof value === 'string' && value.trim()){
            return value.trim();
          }
        }
        return '';
      };

      const fallback =
        String(t.symbol || t.name || '?')
          .charAt(0)
          .toUpperCase();

      const localUrl = first(
        t.imageUrl,
        t.image,
        t.logoUrl,
        t.logo,
        t.metadata?.imageUrl,
        t.metadata?.image
      );

      const showImage = url => {
        if(!url){
          logo.innerHTML = '';
          logo.textContent = fallback;
          return;
        }

        const img = new Image();
        img.alt = '';

        img.onload = () => {
          logo.innerHTML = '';
          logo.appendChild(img);
        };

        img.onerror = () => {
          logo.innerHTML = '';
          logo.textContent = fallback;
        };

        img.src = url;
      };

      if(localUrl){
        showImage(localUrl);
      }else if(d?.mint){
        fetch(
          'https://api.dexscreener.com/token-pairs/v1/solana/' +
          encodeURIComponent(d.mint),
          {headers:{accept:'application/json'}}
        )
          .then(r => r.ok ? r.json() : [])
          .then(pairs => {
            if(!Array.isArray(pairs)){
              showImage('');
              return;
            }

            pairs.sort(
              (a,b) =>
                Number(b?.liquidity?.usd || 0) -
                Number(a?.liquidity?.usd || 0)
            );

            const url = first(
              pairs[0]?.info?.imageUrl,
              ...pairs.map(p => p?.info?.imageUrl)
            );

            showImage(url);
          })
          .catch(() => showImage(''));
      }else{
        showImage('');
      }
    }
  }

  if(document.readyState === 'loading'){
    document.addEventListener(
      'DOMContentLoaded',
      mount,
      {once:true}
    );
  }else{
    mount();
  }

  setTimeout(mount,500);
})();
</script>


<script id="MEMEFLOW_PRIMARY_LOGO_RUNTIME_V1">
(()=>{
  'use strict';

  function ensureLogo(){
    const name=document.getElementById('primaryName');
    if(!name)return;

    if(document.getElementById('primaryTokenLogo'))return;

    const row=document.createElement('div');
    row.id='primaryNameRow';
