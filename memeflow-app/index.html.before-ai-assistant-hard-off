<script id="MEMEFLOW_POSITIONS_SHEET_JS_V1">
(()=>{
  'use strict';

  const isMobile=()=>window.matchMedia('(max-width:820px)').matches;

  function positions(){
    return document.getElementById('positions');
  }

  function moreSheet(){
    return document.getElementById('sheet-more');
  }

  function ensureHeader(){
    const pos=positions();
    if(!pos || pos.querySelector('.mf-positions-mobile-title')) return;

    const head=document.createElement('div');
    head.className='mf-positions-mobile-title';
    head.innerHTML=
      '<div><h2>Positions</h2>'+
      '<small>Open positions & execution management</small></div>'+
      '<button class="mf-positions-mobile-close" type="button" aria-label="Close Positions">×</button>';

    pos.prepend(head);

    head.querySelector('.mf-positions-mobile-close')
      ?.addEventListener('click',()=>{
        closePositions();
        activateHome();
      });
  }

  /*
   * Move the existing System Health panel into More.
   * We MOVE the real node — never clone it.
   */
  function moveSystemHealthToMore(){
    if(!isMobile()) return;

    const pos=positions();
    const more=moreSheet();

    if(!pos || !more) return;

    const candidates=[
      ...pos.querySelectorAll('.panel, article, section')
    ];

    const health=candidates.find(el=>{
      const h=el.querySelector('h1,h2,h3');
      return h && h.textContent.trim().toLowerCase()==='system health';
    });

    if(!health || health.dataset.mfMovedToMore==='1') return;

    let holder=more.querySelector('#mfSystemHealthMore');

    if(!holder){
      holder=document.createElement('div');
      holder.id='mfSystemHealthMore';
      holder.style.marginTop='12px';
      more.appendChild(holder);
    }

    holder.appendChild(health);
    health.dataset.mfMovedToMore='1';
  }

  function closeOtherSheets(){
    document
      .querySelectorAll('.mobile-sheet.open')
      .forEach(el=>el.classList.remove('open'));
  }

  function openPositions(){
    if(!isMobile()) return;

    const pos=positions();
    if(!pos) return;

    closeOtherSheets();
    ensureHeader();
    moveSystemHealthToMore();

    pos.classList.add('mf-positions-open');

    // Do NOT lock body scroll globally.
    // The Positions screen has its own scrolling.
    document.body.style.overflow='';
  }

  function closePositions(){
    positions()?.classList.remove('mf-positions-open');
    document.body.style.overflow='';
  }

  function activateHome(){
    document.querySelectorAll('.mobile-nav [data-sheet]')
      .forEach(b=>b.classList.toggle(
        'active',
        b.dataset.sheet==='home'
      ));
  }

  document.addEventListener('click',e=>{
    const nav=e.target.closest('.mobile-nav [data-sheet]');

    if(nav){
      const target=nav.dataset.sheet;

      if(target==='positions'){
        e.preventDefault();
        e.stopImmediatePropagation();

        document.querySelectorAll('.mobile-nav [data-sheet]')
          .forEach(b=>b.classList.toggle('active',b===nav));

        openPositions();
        return;
      }

      // Any other navigation closes Positions.
      closePositions();
    }

    if(e.target.closest('.close-sheet')){
      closePositions();
    }
  },true);

  window.addEventListener('resize',()=>{
    if(!isMobile()){
      closePositions();
    }else{
      moveSystemHealthToMore();
    }
  });

  function boot(){
    ensureHeader();
    moveSystemHealthToMore();
    closePositions();
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
    boot();
  }
})();
</script>

