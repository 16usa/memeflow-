<script id="MEMEFLOW_EVIDENCE_TRUTH_V1">
(() => {
  'use strict';

  const finite = v => {
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  };

  const firstFinite = (...values) => {
    for (const v of values) {
      const n = finite(v);
      if (n !== null) return n;
    }
    return null;
  };

  const firstValue = (...values) => {
    for (const v of values) {
      if (v !== undefined && v !== null && v !== '') return v;
    }
    return null;
  };

  const parseTime = v => {
    if (v === undefined || v === null || v === '') return null;

    if (typeof v === 'number' || /^[0-9]+(?:\.[0-9]+)?$/.test(String(v))) {
      let n = Number(v);
      if (!Number.isFinite(n) || n <= 0) return null;

      // Unix seconds -> ms
      if (n < 1e12) n *= 1000;
      return n;
    }

    const t = Date.parse(v);
    return Number.isFinite(t) ? t : null;
  };

  const newestTime = values => {
    const good = values.map(parseTime).filter(Number.isFinite);
    return good.length ? Math.max(...good) : null;
  };

  function candidate() {
    try {
      const unified =
        window.MEMEFLOW_UNIFIED_CANDIDATE_SYSTEM?.getCandidate?.();

      if (unified && Object.keys(unified).length) return unified;
    } catch {}

    try {
      const core = window.MEMEFLOW_CORE?.getSelected?.();

      if (core && Object.keys(core).length) return core;
    } catch {}

    return {};
  }

  function chartState() {
    try {
      return window.MEMEFLOW_CHART?.getState?.() || {};
    } catch {
      return {};
    }
  }

  function latestChartTime() {
    const state = chartState();
    const points = Array.isArray(state.points) ? state.points : [];

    for (let i = points.length - 1; i >= 0; i--) {
      const p = points[i] || {};
      const t = firstValue(
        p.t,
        p.time,
        p.timestamp,
        p.ts,
        p.updatedAt
      );

      const parsed = parseTime(t);
      if (parsed) return parsed;
    }

    return null;
  }

  function latestChartPrice() {
    const state = chartState();
    const points = Array.isArray(state.points) ? state.points : [];

    for (let i = points.length - 1; i >= 0; i--) {
      const p = points[i] || {};

      const value = firstFinite(
        p.p,
        p.price,
        p.priceSol,
        p.close,
        p.c,
        p.value
      );

      if (value !== null && value > 0) return value;
    }

    return null;
  }

  function normalizedEvidence(c) {
    const mint = firstValue(
      c.mint,
      c.tokenAddress,
      c.address
    );

    const source = firstValue(
      c.source,
      c.marketSource,
      c.priceSource,
      c.launchSource
    );

    const price = firstFinite(
      c.priceSol,
      c.price,
      c.currentPrice,
      c.market?.priceSol,
      c.market?.price,
      latestChartPrice()
    );

    const holderCount = firstFinite(
      c.holderCount,
      c.holders,
      c.market?.holderCount,
      c.snapshot?.holderCount
    );

    const top10 = firstFinite(
      c.top10Pct,
      c.top10Percent,
      c.top10_percent,
      c.market?.top10Pct,
      c.snapshot?.top10Pct
    );

    const developer = firstFinite(
      c.developerPct,
      c.creatorPct,
      c.developerPercent,
      c.creatorPercent,
      c.market?.developerPct,
      c.snapshot?.developerPct
    );

    const buyPressure = firstFinite(
      c.buyPressure,
      c.buySellRatio,
      c.bsRatio,
      c.momentum,
      c.market?.buyPressure,
      c.snapshot?.buyPressure
    );

    const backendQuality = firstFinite(
      c.dataQuality,
      c.market?.dataQuality,
      c.snapshot?.dataQuality
    );

    const holderFresh = firstValue(
      c.holderFresh,
      c.holderSnapshotFresh,
      c.market?.holderFresh,
      c.snapshot?.holderFresh
    );

    const updatedAt = newestTime([
      c.updatedAt,
      c.updated_at,
      c.evaluatedAt,
      c.evaluated_at,
      c.snapshotAt,
      c.snapshot_at,
      c.marketUpdatedAt,
      c.market_updated_at,
      c.holderUpdatedAt,
      c.holder_updated_at,
      c.holderSnapshotAt,
      c.holder_snapshot_at,
      c.enrichedAt,
      c.enriched_at,
      c.discoveredAt,
      latestChartTime()
    ]);

    return {
      mint,
      source,
      price,
      holderCount,
      top10,
      developer,
      buyPressure,
      backendQuality,
      holderFresh,
      updatedAt
    };
  }

  function calculateCompleteness(e) {
    /*
      Evidence completeness is intentionally independent from user
      thresholds/settings.

      These are factual evidence categories, not admission gates.
    */
    const factual = [
      !!e.mint,
      !!e.source,
      e.price !== null,
      e.holderCount !== null,
      e.top10 !== null,
      e.developer !== null,
      e.buyPressure !== null,
      e.holderFresh === true || e.holderFresh === false ||
        Number.isFinite(e.updatedAt)
    ];

    const present = factual.filter(Boolean).length;

    return Math.round((present / factual.length) * 100);
  }

  function freshness(e) {
    /*
      Explicit backend holderFresh has priority.
      Never turn missing freshness into PASS.
    */
    if (e.holderFresh === false) {
      return { text: 'Stale', level: 'bad' };
    }

    if (!Number.isFinite(e.updatedAt)) {
      if (e.holderFresh === true) {
        return { text: 'Fresh', level: 'good' };
      }

      return { text: 'Unknown', level: 'unknown' };
    }

    const ageSec = Math.max(0, (Date.now() - e.updatedAt) / 1000);

    if (e.holderFresh === true && ageSec <= 60) {
      return { text: 'Fresh', level: 'good' };
    }

    if (ageSec <= 20) {
      return { text: 'Fresh', level: 'good' };
    }

    if (ageSec <= 60) {
      return { text: 'Aging', level: 'warn' };
    }

    return { text: 'Stale', level: 'bad' };
  }

  function quality(e, completeness, fresh) {
    /*
      Prefer backend dataQuality when genuinely supplied.
      evaluate.mjs currently represents dataQuality as 0..1.
    */
    let q = e.backendQuality;

    if (q !== null && q > 1 && q <= 100) {
      q /= 100;
    }

    let text;

    if (q !== null && q >= 0 && q <= 1) {
      if (q >= 0.85) text = 'High';
      else if (q >= 0.60) text = 'Medium';
      else text = 'Low';
    } else {
      if (completeness >= 85) text = 'High';
      else if (completeness >= 60) text = 'Medium';
      else if (completeness > 0) text = 'Partial';
      else text = 'Unknown';
    }

    /*
      Important coherence rule:
      data cannot claim HIGH quality while overall freshness is unknown/stale.
    */
    if (text === 'High' && fresh.level === 'unknown') {
      text = 'Medium';
    }

    if (fresh.level === 'bad') {
      if (text === 'High') text = 'Medium';
    }

    return text;
  }

  function formatUpdated(ts) {
    if (!Number.isFinite(ts)) return 'Not provided';

    const date = new Date(ts);
    if (!Number.isFinite(date.getTime())) return 'Not provided';

    const ageSec = Math.max(0, Math.floor((Date.now() - ts) / 1000));

    if (ageSec < 5) return 'Just now';
    if (ageSec < 60) return `${ageSec}s ago`;

    const mins = Math.floor(ageSec / 60);
    if (mins < 60) return `${mins}m ago`;

    return date.toLocaleString();
  }

  function findValueByLabel(label) {
    /*
      Restrict search to Evidence/inspector area when possible.
      Fall back to document for current single-file layout.
    */
    const roots = [
      document.querySelector('#inspector'),
      document.querySelector('#ai-analysis'),
      document.querySelector('[data-tab-panel="evidence"]'),
      document.querySelector('.inspector'),
      document
    ].filter(Boolean);

    for (const root of roots) {
      const candidates = [
        ...root.querySelectorAll(
          '.data-row, .evidence-row, .detail-row, .info-row, li, tr'
        )
      ];

      for (const row of candidates) {
        const children = [...row.children];
        if (children.length < 2) continue;

        const key = (children[0].textContent || '')
          .replace(/\s+/g, ' ')
          .trim()
          .toLowerCase();

        if (key !== label.toLowerCase()) continue;

        return (
          row.querySelector('b') ||
          row.querySelector('strong') ||
          row.querySelector('[data-value]') ||
          children[children.length - 1]
        );
      }
    }

    return null;
  }

  function paint() {
    const c = candidate();
    const hasCandidate =
      !!firstValue(c.id, c.mint, c.tokenAddress, c.name, c.symbol);

    const e = normalizedEvidence(c);

    if (!hasCandidate) {
      const updated = findValueByLabel('Last updated');
      const fresh = findValueByLabel('Data freshness');
      const qualityEl = findValueByLabel('Data quality');
      const complete = findValueByLabel('Data completeness');

      if (updated) updated.textContent = 'Not provided';
      if (fresh) fresh.textContent = 'Unknown';
      if (qualityEl) qualityEl.textContent = 'Unknown';
      if (complete) complete.textContent = '0%';

      return;
    }

    const completeness = calculateCompleteness(e);
    const fresh = freshness(e);
    const qualityText = quality(e, completeness, fresh);

    const updatedEl = findValueByLabel('Last updated');
    const freshEl = findValueByLabel('Data freshness');
    const qualityEl = findValueByLabel('Data quality');
    const completeEl = findValueByLabel('Data completeness');

    if (updatedEl) {
      updatedEl.textContent = formatUpdated(e.updatedAt);
    }

    if (freshEl) {
      freshEl.textContent = fresh.text;
      freshEl.dataset.evidenceState = fresh.level;
    }

    if (qualityEl) {
      qualityEl.textContent = qualityText;
    }

    if (completeEl) {
      completeEl.textContent = `${completeness}%`;
    }

    // Expose the factual snapshot for diagnostics.
    window.MEMEFLOW_EVIDENCE_STATE = {
      mint: e.mint,
      source: e.source,
      priceAvailable: e.price !== null,
      holdersAvailable: e.holderCount !== null,
      top10Available: e.top10 !== null,
      developerAvailable: e.developer !== null,
      buyPressureAvailable: e.buyPressure !== null,
      holderFresh: e.holderFresh,
      updatedAt: e.updatedAt,
      freshness: fresh.text,
      quality: qualityText,
      completeness
    };
  }

  window.addEventListener('memeflow:candidatechange', () => {
    requestAnimationFrame(paint);
  });

  window.addEventListener('memeflow:statechange', () => {
    requestAnimationFrame(paint);
  });

  window.addEventListener('memeflow:settingschange', () => {
    /*
      Repaint only. Settings MUST NOT manufacture evidence.
    */
    requestAnimationFrame(paint);
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) paint();
  });

  setInterval(paint, 1000);

  setTimeout(paint, 0);
  setTimeout(paint, 500);
  setTimeout(paint, 1500);

  window.MEMEFLOW_EVIDENCE_TRUTH = {
    refresh: paint,
    getState: () => ({ ...(window.MEMEFLOW_EVIDENCE_STATE || {}) })
  };
})();
</script>


