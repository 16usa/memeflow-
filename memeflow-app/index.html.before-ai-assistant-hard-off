<script id="MEMEFLOW_CANDIDATE_CARD_LOGOS_V1">
(()=>{
  'use strict';

  const cache = new Map();
  const pending = new Set();

  async function getImage(mint){
    if(!mint) return '';

    if(cache.has(mint))
      return cache.get(mint);

    if(pending.has(mint))
      return '';

    pending.add(mint);

    try{
      const r = await fetch(
        'https://api.dexscreener.com/token-pairs/v1/solana/' +
        encodeURIComponent(mint),
        {headers:{accept:'application/json'}}
      );

      if(!r.ok){
        cache.set(mint,'');
        return '';
      }

      const pairs = await r.json();

      if(!Array.isArray(pairs)){
        cache.set(mint,'');
        return '';
      }

      pairs.sort(
        (a,b)=>
          Number(b?.liquidity?.usd||0) -
          Number(a?.liquidity?.usd||0)
      );

      const url =
        pairs.find(p=>p?.info?.imageUrl)?.info?.imageUrl ||
        '';

      cache.set(mint,url);
      return url;

    }catch{
      cache.set(mint,'');
      return '';
    }finally{
      pending.delete(mint);
    }
  }

  async function hydrate(el){
    if(!el || el.dataset.logoLoaded==='1') return;

    const mint=(el.dataset.mint||'').trim();
    const symbol=(el.dataset.symbol||'?').trim();

    el.textContent =
      symbol.charAt(0).toUpperCase() || '?';

    if(!mint) return;

    const url=await getImage(mint);

    if(!url) return;

    // Карточка могла уже быть перерисована.
    if(!document.body.contains(el)) return;

    const img=new Image();
    img.alt='';

    img.onload=()=>{
      if(!document.body.contains(el)) return;
      el.innerHTML='';
      el.appendChild(img);
      el.dataset.logoLoaded='1';
    };

    img.src=url;
  }

  function scan(){
    document
      .querySelectorAll('.candidate-token-logo')
      .forEach(hydrate);
  }

  const observer=new MutationObserver(scan);

  observer.observe(document.body,{
    childList:true,
    subtree:true
  });

  setInterval(scan,2500);
  scan();
})();
</script>


