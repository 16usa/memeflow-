  }

  function currentCandidate(){
    try{
      return window.MEMEFLOW_CORE?.getSelected?.() || {};
    }catch{
      return {};
    }
  }

  async function renderLogo(){
    ensureLogo();

    const logo=document.getElementById('primaryTokenLogo');
    if(!logo)return;

    const c=currentCandidate();

    const first=(...vals)=>{
      for(const v of vals){
        if(typeof v==='string' && v.trim())return v.trim();
      }
      return '';
    };

    const symbol=first(c.symbol,c.name);
    const fallback=symbol ? symbol[0].toUpperCase() : '?';

    const mint=first(
      c.mint,
      c.tokenAddress,
      c.address
    );

    const localUrl=first(
      c.imageUrl,
      c.image,
      c.logoUrl,
      c.logo,
      c.metadata?.imageUrl,
      c.metadata?.image
    );

    const showImage=url=>{
      if(!url){
        logo.innerHTML='';
        logo.textContent=fallback;
        return;
      }

      const img=new Image();
      img.alt='';
      img.style.width='100%';
      img.style.height='100%';
      img.style.objectFit='cover';
      img.style.display='block';

      img.onload=()=>{
        logo.innerHTML='';
        logo.appendChild(img);
      };

      img.onerror=()=>{
        logo.innerHTML='';
        logo.textContent=fallback;
      };

      img.src=url;
    };

    if(localUrl){
      showImage(localUrl);
      return;
    }

    if(!mint){
      showImage('');
      return;
    }

    try{
      const r=await fetch(
        'https://api.dexscreener.com/token-pairs/v1/solana/' +
        encodeURIComponent(mint),
        {headers:{accept:'application/json'}}
      );

      if(!r.ok){
        showImage('');
        return;
      }

      const pairs=await r.json();

      if(!Array.isArray(pairs)){
        showImage('');
        return;
      }

      pairs.sort(
        (a,b)=>
          Number(b?.liquidity?.usd||0) -
          Number(a?.liquidity?.usd||0)
      );

      const url=first(
        pairs[0]?.info?.imageUrl,
        ...pairs.map(p=>p?.info?.imageUrl)
      );

      showImage(url);
    }catch{
      showImage('');
    }
  }

  const boot=()=>{
    ensureLogo();
    renderLogo();
  };

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',boot,{once:true});
  }else{
