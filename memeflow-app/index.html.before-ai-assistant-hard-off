html,body{max-width:100%;overflow-x:hidden}
.wallet-panel,.wallet-panel .panel-body,.wallet-overview,.wallet-card,.wallet-security,
.wallet-identity,.wallet-title,.wallet-title>div:last-child,.wallet-actions{min-width:0;max-width:100%;box-sizing:border-box}
.wallet-title small{overflow-wrap:anywhere;word-break:break-word}
@media(max-width:600px){
  .wallet-panel{width:100%;overflow:hidden}
  .wallet-panel .panel-head{gap:8px;align-items:center}
  .wallet-panel .panel-head h2{min-width:0;font-size:13px}
  .wallet-panel .panel-head .state{flex:0 0 auto;font-size:8px;padding:7px 9px}
  .wallet-overview{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;padding:10px}
  .wallet-card,.wallet-security{width:100%;padding:12px}
  .wallet-identity{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;align-items:start}
  .wallet-title{display:grid;grid-template-columns:42px minmax(0,1fr);gap:10px;align-items:center;width:100%}
  .wallet-title small{max-width:none;white-space:normal;line-height:1.45;margin-top:4px}
  #walletNetworkBadge{justify-self:start;max-width:100%;margin-left:52px}
  .wallet-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .wallet-stat{min-width:0;padding:10px}
  .wallet-stat b{font-size:10px;line-height:1.35}
  .wallet-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;width:100%}
  .wallet-actions .btn{width:100%;min-width:0;padding:9px 8px;white-space:normal;line-height:1.25}
  .wallet-actions .btn:first-child{grid-column:1/-1}
  .wallet-security p{overflow-wrap:anywhere}
  .wallet-rule{min-width:0;align-items:flex-start}
  .wallet-rule span{min-width:0;overflow-wrap:anywhere}
  .wallet-rule b{flex:0 0 auto}
}
@media(max-width:360px){
  .wallet-overview{padding:8px}
  .wallet-card,.wallet-security{padding:10px}
  .wallet-grid,.wallet-actions{grid-template-columns:minmax(0,1fr)}
  .wallet-actions .btn:first-child{grid-column:auto}
  #walletNetworkBadge{margin-left:0}
}

