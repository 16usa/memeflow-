</div></div>`


function bindVaultConnect(){
 if(!isVault)return;
 const b=document.querySelector('#mf-ag-wallet-connect');
 if(!b||b.dataset.bound)return;
 b.dataset.bound='1';

 b.addEventListener('click',()=>{
   const candidates=[...document.querySelectorAll('button,a')].filter(x=>
     !x.closest('#mf-access-gate') &&
     /connect wallet|connect phantom|use phantom|phantom|solflare/i.test(
       (x.textContent||'').trim()
     )
   );

   const native=candidates.find(x=>!x.disabled);
   if(native){
     native.click();
     return;
   }

   const target=encodeURIComponent(location.href);
   location.href='https://phantom.app/ul/browse/'+target;
 });
}

function locked(){if(!document.querySelector('#mf-access-gate'))document.body.insertAdjacentHTML('beforeend',card());bindVaultConnect()}
function pepper(){document.querySelector('#mf-access-gate')?.remove();if(!document.querySelector('#mf-access-ribbon'))document.body.insertAdjacentHTML('beforeend','<div id="mf-access-ribbon">PEPPER ACTIVE · LIVE LOCKED AT $49.99</div>')}
function live(){document.querySelector('#mf-access-gate')?.remove();document.querySelector('#mf-access-ribbon')?.remove()}

async function sync(){
 try{
  const r=await fetch('/api/access/page',{credentials:'same-origin',cache:'no-store'});
  const s=await r.json();
  if(s.tier==='live')live();else if(s.tier==='pepper'&&!isVault)pepper();else locked();
 }catch{locked()}
}
sync();setInterval(sync,15000);
})();

/* === MEMEFLOW ACCESS ICONS PATCH === */
(function () {
  if (window.__MF_ACCESS_ICONS_PATCH__) return;
  window.__MF_ACCESS_ICONS_PATCH__ = true;

  function icon(name) {
    const map = {
      pepper: `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v4"></path>
          <path d="M6.5 6.5l2.8 2.8"></path>
          <path d="M17.5 6.5l-2.8 2.8"></path>
          <path d="M4 13c2.2 0 3.8-.9 5-2.1 1.2 1.2 2.8 2.1 5 2.1 2.2 0 3.8-.9 5-2.1"></path>
          <path d="M6 17c1.6 0 2.9-.6 4-1.6 1.1 1 2.4 1.6 4 1.6"></path>
        </svg>
      `,
      live: `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8Z"></path>
        </svg>
      `,
      wallet: `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H18a2 2 0 0 1 2 2v1"></path>
          <path d="M3 8h15a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8Z"></path>
          <circle cx="17" cy="13.5" r="1"></circle>
        </svg>
      `,
      shield: `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7 3v5c0 4.8-2.8 7.8-7 10-4.2-2.2-7-5.2-7-10V6l7-3Z"></path>
          <path d="M9.5 12.5l1.7 1.7 3.8-4.2"></path>
        </svg>
      `
    };
    return map[name] || '';
  }

  function hasText(el, txt) {
    return el && el.textContent && el.textContent.toLowerCase().includes(txt.toLowerCase());
  }

  function addIconToBlock(el, name) {
    if (!el || el.querySelector('.mf-ag-inline-icon')) return;
    const wrap = document.createElement('span');
    wrap.className = 'mf-ag-inline-icon';
    wrap.innerHTML = icon(name);
    el.insertBefore(wrap, el.firstChild);
    el.classList.add('mf-ag-with-icon');
  }

  function addIconToButton(el, name) {
    if (!el || el.querySelector('.mf-ag-btn-icon')) return;
    const wrap = document.createElement('span');
    wrap.className = 'mf-ag-btn-icon';
    wrap.innerHTML = icon(name);
    el.insertBefore(wrap, el.firstChild);
    el.classList.add('mf-ag-btn-with-icon');
  }

  function addIconToNote(el, name) {
    if (!el || el.querySelector('.mf-ag-note-icon')) return;
    const wrap = document.createElement('span');
    wrap.className = 'mf-ag-note-icon';
    wrap.innerHTML = icon(name);
    el.insertBefore(wrap, el.firstChild);
    el.classList.add('mf-ag-note-with-icon');
  }

  function decorateModal(modal) {
    if (!modal || modal.dataset.mfAgIconsDone === '1') return;

    const all = Array.from(modal.querySelectorAll('*'));

    const pepperTitle = all.find(el =>
      ['H1','H2','H3','H4','DIV','SPAN','P','STRONG'].includes(el.tagName) &&
      hasText(el, 'PEPPER MODE')
    );

    const liveTitle = all.find(el =>
      ['H1','H2','H3','H4','DIV','SPAN','P','STRONG'].includes(el.tagName) &&
      hasText(el, 'LIVE MODE')
    );

    const actionBtn = all.find(el =>
      ['BUTTON','A','DIV'].includes(el.tagName) &&
      (hasText(el, 'CHECK MEMEFLOW BALANCE') || hasText(el, 'CONNECT WALLET'))
    );

    const noteText = all.find(el =>
      ['P','DIV','SPAN','SMALL'].includes(el.tagName) &&
      (hasText(el, 'No payment') || hasText(el, 'No subscription fee') || hasText(el, 'MEMEFLOW only verifies'))
    );

    addIconToBlock(pepperTitle, 'pepper');
    addIconToBlock(liveTitle, 'live');
    addIconToButton(actionBtn, 'wallet');
    addIconToNote(noteText, 'shield');

    modal.dataset.mfAgIconsDone = '1';
  }

  function findModal() {
    return document.querySelector(
      '.mf-ag-modal, .mf-access-gate, .access-gate-modal, .access-gate, [data-mf-access-gate], [data-access-gate]'
    );
  }

  function run() {
    const modal = findModal();
    if (modal) decorateModal(modal);
  }

  const obs = new MutationObserver(run);
  obs.observe(document.documentElement || document.body, { childList: true, subtree: true });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run, { once: true });
  } else {
    run();
  }

  setTimeout(run, 400);
  setTimeout(run, 1200);
})();

/* MEMEFLOW ACCESS ICONS FIX V11 */
(()=>{
  if(window.__MF_ACCESS_ICONS_V11__) return;
  window.__MF_ACCESS_ICONS_V11__=1;

  const icons={
    pepper:`<svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>
    </svg>`,

    live:`<svg viewBox="0 0 24 24" fill="none">
      <path d="M13 2 5 13h6l-1 9 9-12h-6l0-8Z"/>
    </svg>`,

    wallet:`<svg viewBox="0 0 24 24" fill="none">
      <path d="M4 7h14a2 2 0 0 1 2 2v9H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h11"/>
      <path d="M16 11h5v4h-5a2 2 0 1 1 0-4Z"/>
    </svg>`,

    shield:`<svg viewBox="0 0 24 24" fill="none">
      <path d="M12 3 19 6v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>`
  };

  function icon(name,cls){
    const s=document.createElement('span');
    s.className=cls;
    s.innerHTML=icons[name];
    return s;
  }

  function decorate(){
    document.querySelectorAll('.mf-ag-tier b').forEach(b=>{
      if(b.querySelector('.mf-ag-mini-icon')) return;

      const text=b.textContent.toUpperCase();

      if(text.includes('PEPPER'))
        b.prepend(icon('pepper','mf-ag-mini-icon'));

      if(text.includes('LIVE'))
        b.prepend(icon('live','mf-ag-mini-icon'));
    });

    document.querySelectorAll('.mf-ag-btn').forEach(b=>{
      if(b.querySelector('.mf-ag-btn-icon')) return;
      b.prepend(icon('wallet','mf-ag-btn-icon'));
    });

    document.querySelectorAll('.mf-ag-foot').forEach(n=>{
      if(n.querySelector('.mf-ag-note-icon')) return;
      n.prepend(icon('shield','mf-ag-note-icon'));
    });
  }

  new MutationObserver(decorate).observe(
    document.documentElement,
    {childList:true,subtree:true}
  );

  decorate();
})();

/* MEMEFLOW V14 — REMOVE PEPPER/LIVE ICONS ONLY */
(()=>{
  if(window.__MF_REMOVE_TIER_ICONS_V14__) return;
  window.__MF_REMOVE_TIER_ICONS_V14__=1;

  function clean(){
    document.querySelectorAll('.mf-ag-tier .mf-ag-mini-icon')
      .forEach(el=>el.remove());
  }

  new MutationObserver(clean).observe(
    document.documentElement,
    {childList:true,subtree:true}
  );

  clean();
})();
