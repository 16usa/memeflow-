.paper-note{margin-top:15px;border-top:1px solid var(--line);padding-top:13px}.paper-note b,.paper-note span{display:block}.paper-note b{font-size:9px;color:var(--green)}.paper-note span{font-size:9px;line-height:1.45;color:var(--muted);margin-top:4px}
.flight-card{min-height:720px;position:relative;display:flex;flex-direction:column}.flight-head{padding:17px 18px 0;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;z-index:3}.status-pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:999px;padding:6px 9px;font-size:8px;font-weight:900;letter-spacing:.11em;color:#d9e2eb}.status-pill i{width:6px;height:6px;border-radius:50%;background:var(--muted)}.game-shell[data-state="searching"] .status-pill i{background:var(--cyan);box-shadow:0 0 10px var(--cyan);animation:pulse 1s infinite}.game-shell[data-state="live"] .status-pill i{background:var(--green);box-shadow:0 0 10px var(--green);animation:pulse 1s infinite}.game-shell[data-state="complete"] .status-pill i{background:var(--green)}.status-message{font-size:9px;color:var(--muted);margin-top:6px}.round-id{text-align:right}.round-id small{display:block;font-size:7px;color:var(--muted);letter-spacing:.12em}.round-id b{font-size:9px;margin-top:3px;display:block;color:#b9c5d2}
.multiplier-wrap{text-align:center;position:absolute;left:50%;top:73px;transform:translateX(-50%);z-index:6;pointer-events:none}.multiplier{font-size:clamp(58px,7vw,92px);line-height:.9;letter-spacing:-.065em;font-weight:950;font-variant-numeric:tabular-nums;background:linear-gradient(180deg,#fff 5%,#92f4cb 94%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 10px 30px rgba(81,231,168,.13))}.multiplier span{font-size:.42em;margin-left:4px}.multiplier.negative{background:linear-gradient(180deg,#fff,#ff8998);-webkit-background-clip:text;background-clip:text}.multiplier-caption{font-size:7px;letter-spacing:.18em;color:var(--muted);font-weight:800;margin-top:9px}
.sky{position:absolute;inset:0 0 72px;overflow:hidden;background:linear-gradient(180deg,#04070c 0%,#07131e 44%,#0b2634 70%,#17414a 100%);border-radius:18px 18px 0 0}.sky:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 25%,rgba(84,221,255,.08),transparent 24%),linear-gradient(90deg,rgba(255,255,255,.02),transparent 30%,transparent 70%,rgba(255,255,255,.02));pointer-events:none}.stars{position:absolute;inset:-20% 0 35%;opacity:.75;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:37px 37px}.stars-b{background-size:71px 71px;transform:translate(21px,13px);opacity:.28}.moon{position:absolute;width:82px;height:82px;border-radius:50%;right:9%;top:21%;background:radial-gradient(circle at 34% 32%,#e5edf3 0 11%,#8e9ba6 42%,#515d66 72%);opacity:.55;box-shadow:0 0 38px rgba(210,230,242,.12)}
.cloud{position:absolute;width:210px;height:34px;border-radius:50%;background:rgba(210,235,240,.13);filter:blur(7px);bottom:20%;opacity:.7}.cloud:before,.cloud:after{content:"";position:absolute;border-radius:50%;background:inherit}.cloud:before{width:86px;height:55px;left:33px;bottom:-5px}.cloud:after{width:100px;height:67px;right:24px;bottom:-8px}.cloud-a{left:-55px}.cloud-b{right:-80px;bottom:28%;transform:scale(.75)}
.earth{position:absolute;left:-15%;right:-15%;height:180px;bottom:-126px;border-radius:50% 50% 0 0;background:radial-gradient(ellipse at 50% 0%,#3d756e 0 8%,#1d4c57 30%,#0c2633 64%,#071017 75%);box-shadow:0 -18px 55px rgba(81,231,168,.11)}.launch-pad{position:absolute;bottom:45px;left:50%;transform:translateX(-50%);z-index:2}.launch-pad span{display:block;width:112px;height:7px;background:#17232d;border:1px solid #2b3b49;border-radius:50%}.launch-pad i{display:block;width:2px;height:53px;background:#314553;margin:auto;box-shadow:18px 8px 0 #263844,-18px 12px 0 #263844}
.altitude{position:absolute;left:15px;right:15px;border-top:1px dashed rgba(255,255,255,.06);z-index:1}.altitude span{position:absolute;right:3px;top:-13px;font-size:7px;color:rgba(200,214,225,.42);font-variant-numeric:tabular-nums}.altitude-5{top:18%}.altitude-2{top:34%}.altitude-15{top:48%}.altitude-12{top:61%}.altitude-1{top:76%}
.trajectory{position:absolute;left:50%;bottom:88px;width:2px;height:60%;transform:translateX(-50%);opacity:.32;background:linear-gradient(to top,var(--green),var(--cyan),transparent);filter:blur(.2px)}.trajectory i{position:absolute;inset:0;box-shadow:0 0 28px rgba(84,221,255,.3)}
.rocket-wrap{position:absolute;z-index:5;left:50%;bottom:83px;width:100px;height:172px;transform:translate3d(-50%,0,0) rotate(0deg);transform-origin:50% 70%;transition:transform 650ms cubic-bezier(.2,.8,.2,1);will-change:transform}.rocket-glow{position:absolute;width:100px;height:100px;left:0;bottom:0;border-radius:50%;background:radial-gradient(circle,rgba(84,221,255,.21),transparent 68%);filter:blur(8px);opacity:.35}.rocket-body{position:absolute;width:48px;height:98px;left:26px;bottom:27px;border-radius:58% 58% 34% 34% / 38% 38% 18% 18%;background:linear-gradient(90deg,#64727f,#e1e9ee 42%,#fcffff 54%,#82919e);border:1px solid rgba(255,255,255,.4);box-shadow:inset -7px 0 11px rgba(0,0,0,.17),0 10px 25px rgba(0,0,0,.25)}.rocket-body:before{content:"";position:absolute;left:4px;right:4px;top:-27px;height:45px;border-radius:50% 50% 20% 20%;background:linear-gradient(90deg,#ff566b,#ff8a61 45%,#ff5f72);clip-path:polygon(50% 0,100% 100%,0 100%)}.rocket-window{position:absolute;width:24px;height:24px;border-radius:50%;left:11px;top:21px;border:3px solid #4c5964;background:radial-gradient(circle at 35% 30%,#a7f1ff,#28738b 72%);box-shadow:inset 0 0 8px #071017}.rocket-fin{position:absolute;width:22px;height:35px;bottom:4px;background:linear-gradient(#ff6576,#c63e55);z-index:-1}.fin-left{left:-13px;clip-path:polygon(100% 0,100% 100%,0 100%)}.fin-right{right:-13px;clip-path:polygon(0 0,100% 100%,0 100%)}
.frog-mascot{position:absolute;z-index:4;left:21px;top:14px;width:58px;height:48px;border-radius:48% 52% 44% 44%;background:linear-gradient(135deg,#78d270,#309a59);border:2px solid rgba(10,52,30,.65);box-shadow:inset 0 -7px 0 rgba(15,88,48,.2),0 8px 16px rgba(0,0,0,.22)}.frog-mascot:before,.frog-mascot:after{content:"";position:absolute;top:-10px;width:24px;height:23px;border-radius:50%;background:#72ca6b;border:2px solid rgba(10,52,30,.6)}.frog-mascot:before{left:3px}.frog-mascot:after{right:3px}.frog-eye{position:absolute;z-index:3;top:-2px;width:7px;height:9px;border-radius:50%;background:#111;box-shadow:0 0 0 4px #e3f1dd}.frog-eye.left{left:13px}.frog-eye.right{right:13px}.frog-mouth{position:absolute;left:12px;right:12px;bottom:8px;height:10px;border-bottom:3px solid #17452e;border-radius:50%}
