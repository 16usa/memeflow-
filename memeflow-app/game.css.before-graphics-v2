button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
.glass{border:1px solid var(--line);background:linear-gradient(180deg,rgba(14,20,28,.91),rgba(8,12,17,.95));box-shadow:var(--shadow);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
