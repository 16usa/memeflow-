.control-panel,.flight-card,.intel-card{border-radius:18px;overflow:hidden}.control-panel{padding:20px;align-self:start;position:sticky;top:88px}.panel-kicker{font-size:9px;letter-spacing:.16em;color:var(--cyan);font-weight:900}.control-panel h1{font-size:30px;letter-spacing:-.045em;margin:7px 0 7px}.panel-copy{font-size:11px;line-height:1.55;color:#9aa8b8;margin:0 0 21px}.field-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-weight:800}
