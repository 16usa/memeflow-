.intel-panel{display:grid;gap:14px;align-content:start}.intel-card{padding:15px}.intel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}.intel-head>span{font-size:8px;letter-spacing:.14em;color:var(--muted);font-weight:900}.intel-head>b{font-size:8px;color:var(--cyan)}.intel-head button{border:0;background:transparent;color:var(--muted);font-size:8px}.intel-head button:hover{color:#fff}.token-line{display:flex;align-items:center;gap:10px;min-width:0}.token-orb{width:43px;height:43px;flex:0 0 43px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,rgba(84,221,255,.15),rgba(81,231,168,.08));border:1px solid rgba(84,221,255,.22);font-weight:900;font-size:17px}.token-line>div:last-child{min-width:0}.token-line b,.token-line small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.token-line b{font-size:13px}.token-line small{font-size:8px;color:var(--muted);margin-top:4px}.screening-grid{display:grid;grid-template-columns:1fr 1fr;margin-top:15px;border:1px solid var(--line);border-radius:11px;overflow:hidden}.screening-grid>div{padding:10px}.screening-grid>div:nth-child(even){border-left:1px solid var(--line)}.screening-grid>div:nth-child(n+3){border-top:1px solid var(--line)}.screening-grid small,.risk-line span{display:block;color:var(--muted);font-size:7px;text-transform:uppercase;letter-spacing:.08em}.screening-grid b{display:block;margin-top:4px;font-size:10px}.risk-line{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:12px;padding-top:11px;border-top:1px solid var(--line)}.risk-line b{font-size:8px;color:var(--green);text-align:right}
