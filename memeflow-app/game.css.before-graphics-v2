.result-overlay[hidden]{display:none}.result-overlay{position:fixed;inset:0;z-index:100;background:rgba(1,3,5,.76);backdrop-filter:blur(16px);display:grid;place-items:center;padding:18px}.result-card{width:min(430px,100%);border-radius:20px;padding:28px;text-align:center}.result-eyebrow{font-size:8px;letter-spacing:.17em;color:var(--cyan);font-weight:900}.result-multiplier{font-size:66px;font-weight:950;letter-spacing:-.06em;margin:12px 0 2px;font-variant-numeric:tabular-nums}.result-card h2{font-size:20px;margin:0 0 20px}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:12px;overflow:hidden}.result-grid>div{padding:12px 7px}.result-grid>div+div{border-left:1px solid var(--line)}.result-grid small{display:block;font-size:7px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}.result-grid b{display:block;margin-top:5px;font-size:11px}.result-card button{width:100%;height:50px;margin-top:16px;border:0;border-radius:12px;background:#e9f8fd;color:#071017;font-weight:900;font-size:10px;letter-spacing:.1em}
@keyframes pulse{50%{opacity:.35;transform:scale(.82)}}@keyframes flame{to{transform:scaleY(.7) scaleX(1.15);filter:brightness(1.2)}}@keyframes searchShake{0%,100%{transform:translate3d(-50%,0,0) rotate(-1deg)}50%{transform:translate3d(-50%,-3px,0) rotate(1deg)}}
