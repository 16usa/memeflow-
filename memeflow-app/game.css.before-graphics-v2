.game-shell:before{content:"";position:fixed;inset:0;z-index:-2;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:56px 56px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.4),transparent 78%)}
.game-topbar{min-height:72px;padding:12px clamp(14px,2.4vw,30px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;border-bottom:1px solid var(--line);background:rgba(5,7,10,.80);backdrop-filter:blur(20px);position:sticky;top:0;z-index:50}
.brand{display:flex;align-items:center;gap:11px;width:max-content}.brand>span:last-child{display:flex;gap:7px;align-items:baseline}.brand b{font-size:13px;letter-spacing:.12em}.brand small{font-size:9px;letter-spacing:.16em;color:var(--cyan)}
.brand-mark{width:34px;height:34px;border:1px solid rgba(84,221,255,.34);border-radius:11px;display:grid;place-items:center;position:relative;background:rgba(84,221,255,.035)}.brand-mark i{position:absolute;width:18px;height:2px;background:var(--cyan);box-shadow:0 6px 0 rgba(81,231,168,.86)}.brand-mark i:last-child{width:10px;transform:translate(-4px,10px);box-shadow:none}
.paper-badge{justify-self:center;border:1px solid rgba(81,231,168,.24);background:rgba(81,231,168,.06);color:var(--green);border-radius:999px;padding:8px 12px;font-size:9px;font-weight:900;letter-spacing:.12em}.paper-badge i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);margin-right:7px}
.top-balance{justify-self:end;text-align:right}.top-balance small{display:block;color:var(--muted);font-size:8px;text-transform:uppercase;letter-spacing:.12em}.top-balance b{display:block;margin-top:4px;font-size:16px;font-variant-numeric:tabular-nums}
