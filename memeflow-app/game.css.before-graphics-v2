.game-shell[data-state="idle"] .rocket-flame{opacity:.3}.game-shell[data-state="searching"] .rocket-wrap{animation:searchShake 1.1s infinite}.game-shell[data-state="live"] .rocket-wrap{filter:drop-shadow(0 0 18px rgba(81,231,168,.1))}.game-shell[data-stage="space"] .sky{background:linear-gradient(180deg,#020307 0%,#030913 56%,#071823 100%)}.game-shell[data-stage="deep"] .sky{background:radial-gradient(circle at 60% 30%,rgba(91,66,150,.2),transparent 26%),linear-gradient(#010207,#030510)}
