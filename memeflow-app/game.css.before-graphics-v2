.control-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px}.control-grid label>span{display:block;font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}.control-grid select{width:100%;height:40px;background:#0a1016;border:1px solid var(--line);border-radius:9px;padding:0 9px;outline:none;font-size:10px}
