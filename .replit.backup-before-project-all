run = "cd memeflow-app && exec node app-server.mjs"
modules = ["nodejs-24", "python-base-3.13"]

[deployment]
run = ["node", "memeflow-app/app-server.mjs"]
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "MEMEFLOW"

[[workflows.workflow]]
name = "MEMEFLOW"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd memeflow-app && node app-server.mjs"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081
