run = "npm start"
modules = ["nodejs-24", "python-base-3.13"]

[deployment]
run = ["node", "memeflow-app/app-server.mjs"]
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MEMEFLOW"

[[workflows.workflow]]
name = "MEMEFLOW"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd memeflow-app && node app-server.mjs"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ALLOW_ANONYMOUS_PAPER = "true"
DATA_DIR = "./data"
DISCOVERY_BACKFILL_LIMIT = "100"
DISCOVERY_ENABLED = "true"
DISCOVERY_MAX_TOKENS = "5000"
POLL_ACTIVE_MS = "2000"
SOLANA_COMMITMENT = "confirmed"
STALE_MS = "20000"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 25904
externalPort = 3000
