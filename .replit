run = "cd memeflow-app && exec node live-bootstrap.mjs"
modules = ["nodejs-24", "python-base-3.13"]

[deployment]
run = ["node", "memeflow-app/live-bootstrap.mjs"]
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "MEMEFLOW"

[[workflows.workflow]]
name = "MEMEFLOW"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd memeflow-app && exec node live-bootstrap.mjs"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 80
